source "https://rubygems.org"

# macOS ships Ruby 2.6, which is EOL and lives in a read-only directory.
# Install a current one with `brew install ruby` and put it ahead of the
# system Ruby on your PATH.
ruby ">= 3.0.0"

# No plugins on purpose: everything this project needs is a core action, and
# plugins are one more thing that breaks on a fastlane upgrade.
gem "fastlane"
