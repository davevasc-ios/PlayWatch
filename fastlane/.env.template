# Local credentials for fastlane.
#
# Copy this file to `fastlane/.env` and fill in the values. That file is
# gitignored and must never be committed — it holds live credentials.
# CI does not use it: GitHub Actions injects the same names as secrets.
#
#   cp fastlane/.env.template fastlane/.env

# ── App Store Connect API ────────────────────────────────────────────────
# From App Store Connect → Users and Access → Integrations → App Store
# Connect API. The key must have the App Manager role; Developer cannot
# upload builds.
ASC_KEY_ID=
ASC_ISSUER_ID=

# The .p8 file, base64-encoded on a single line. Generate it with:
#   base64 -i ~/path/to/AuthKey_XXXXXXXX.p8 | pbcopy
# and paste the result here. Encoding it avoids the newlines in the raw PEM,
# which are the most common cause of "Authentication credentials are missing
# or invalid" halfway through a pipeline.
ASC_KEY_P8_BASE64=

# ── fastlane match ───────────────────────────────────────────────────────
# Passphrase you choose the first time you run `fastlane certificates`.
# It encrypts the certificates stored in the ios-certificates repository.
MATCH_PASSWORD=
MATCH_GIT_URL=https://github.com/davevasc-ios/ios-certificates.git

# ── App API keys ─────────────────────────────────────────────────────────
# The same four values that live in your local APIKey-Info.plist. fastlane
# writes them into the plist at build time, since that file is gitignored and
# a fresh checkout has no copy.
MOVIEDB_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEP_SEEK_API_KEY=
