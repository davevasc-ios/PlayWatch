# macOS
.DS_Store
._*
.Spotlight-V100
.Trashes

# Xcode — per-developer settings
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout

# xcshareddata/ is intentionally NOT ignored: shared schemes belong in
# version control so the project opens the same way on every machine.

# Xcode — build output
build/
DerivedData/
*.moved-aside
*.hmap
*.ipa
*.dSYM
*.dSYM.zip

# Playgrounds
timeline.xctimeline
playground.xcworkspace

# Swift Package Manager
.build/
.swiftpm/xcode/package.xcworkspace/xcuserdata/

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/test_output/
vendor/bundle/
.bundle/

# Local credentials for fastlane. Never commit: holds the App Store Connect
# key and the API keys. See fastlane/.env.template for the expected shape.
fastlane/.env
fastlane/.env.*
!fastlane/.env.template

# Secrets — see APIKey-Info.plist.template for the expected structure
**/APIKey-Info.plist
